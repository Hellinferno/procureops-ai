# PayPal: explicit simulation or real Sandbox
PAYPAL_MODE=simulation
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Required only for Sandbox payouts: an owned test recipient, not a catalog email
PAYPAL_PAYOUT_RECEIVER_EMAIL=
# Optional: registered Sandbox webhook ID for an HTTPS listener
PAYPAL_WEBHOOK_ID=

# Model provider. Never put API keys in frontend environment files.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free
# Legacy/direct OpenAI: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

PORT=8000
BIND_HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional absolute directory containing catalog.json, transactions.json and seed_transactions.json
# DATA_DIR=D:/paypal/backend/data
