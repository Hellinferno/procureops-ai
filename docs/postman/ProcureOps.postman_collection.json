{
  "info": {
    "name": "ProcureOps AI local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests individually in lifecycle order. Default is simulation. Sandbox capture requires browser approval first. No secrets are stored in this collection."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "paypal_order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Healthy Rust API\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Checkout configuration (public values only)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/paypal/config",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "paypal",
            "config"
          ]
        }
      }
    },
    {
      "name": "Ledger",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/transactions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      }
    },
    {
      "name": "Catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/catalog",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "catalog"
          ]
        }
      }
    },
    {
      "name": "Prepare compliant purchase",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/mandate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mandate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Buy 10 Raspberry Pi 5 under $900 within 3 days\",\n  \"authorized_budget\": 900,\n  \"request_id\": \"{{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order prepared\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "if (data.transaction) { pm.collectionVariables.set(\"order_id\", data.transaction.order_id); pm.collectionVariables.set(\"paypal_order_id\", data.transaction.paypal_order_id || \"\"); }",
              "pm.test(\"Approval is required\", () => pm.expect(data.transaction.status).to.eql(\"AWAITING_APPROVAL\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Treasury query",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/analytics/query",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "analytics",
            "query"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Show all blocked orders or orders over $500\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Capture (approve in browser first in Sandbox)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/paypal/capture",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "paypal",
            "capture"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Refresh payment (does not capture)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/paypal/payment/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "paypal",
            "payment",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cancel uncaptured checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/paypal/cancel",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "paypal",
            "cancel"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create payout (owned Sandbox receiver required)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/paypal/payout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "paypal",
            "payout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Refresh payout recipient status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/paypal/payout/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "paypal",
            "payout",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Reset simulation only",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reset",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reset"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
